<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #333; line-height: 1.6; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .banner { background-color: #dc2626; color: white; padding: 15px 20px; border-radius: 8px 8px 0 0; }
    .content { padding: 20px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px; }
    .btn { display: inline-block; background-color: #dc2626; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 15px; }
    .footer { margin-top: 20px; font-size: 12px; color: #6b7280; text-align: center; }
  </style>
</head>
<body>
  <div class="container">
    <div class="banner">
      <h2 style="margin: 0;">🚨 Action Required: Escalation</h2>
    </div>
    <div class="content">
      <p>Hello <strong>{{escalateTo.name}}</strong>,</p>
      <p>{{body}}</p>
      
      <p style="text-align: center;">
        <a href="{{appUrl}}" class="btn">Open Portal</a>
      </p>
    </div>
    <div class="footer">AtomQuest Goal Tracking Portal</div>
  </div>
</body>
</html>
